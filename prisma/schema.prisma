generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CATEGORY {
  HOODIE
  SWEAT_SHIRTS
  OVERSIZED_TSHIRTS
}

enum SIZE {
  S
  M
  L
  XL
}

enum CURRENCY_TYPE {
  PERCENTAGE
  CURRENCY_TYPE
}

enum ACTIVE_STATUS {
  ACTIVE
  EXPIRED
}

enum ROLE_TITLE {
  SUPER_ADMIN
  USER
}

enum PAYMENT_MODE {
  ONLINE
  CASH_ON_DELIVERY
}

enum PAYMENT_STATUS {
  SUCCESS
  FAILED
  PROCESSING
}

enum ORDER_STATUS {
  RECEIVED
  SHIPPED
  DELIVERED
  REJECTED
}

model Roles {
  roleId   Int        @id @default(autoincrement())
  roleName ROLE_TITLE

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  user Users[]
}

model Users {
  userId     Int     @id @default(autoincrement())
  fName      String?
  lName      String?
  email      String  @unique
  roleId     Int
  mobile     String?
  password   String?
  country    String?
  state      String?
  city       String?
  address    String?
  pincode    String?
  isVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  role Roles @relation(fields: [roleId], references: [roleId])

  carts             UserCart[]
  userOrders        UserOrder[]
  sessions          UserSession[]
  userCouponMapping UserCouponMapping[]
}

model Products {
  productId   Int      @id @default(autoincrement())
  title       String
  description String
  image       String?
  price       String?
  categories  CATEGORY
  size        SIZE
  quantity    Int
  detail      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  orders        Orders[]
  carts         UserCart[]
  productCoupon ProductCouponMapping[]
}

model Coupons {
  couponId         Int           @id @default(autoincrement())
  title            String
  description      String
  couponCode       String
  couponDiscount   Int
  currencyType     CURRENCY_TYPE
  couponTerms      String
  discountMaxLimit Int
  maxCoupon        Int
  status           Boolean

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  userCoupon    UserCouponMapping[]
  productCoupon ProductCouponMapping[]
}

model UserCouponMapping {
  userCouponId Int           @id @default(autoincrement())
  userId       Int
  couponId     Int
  amount       Int
  status       ACTIVE_STATUS

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  user   Users   @relation(fields: [userId], references: [userId])
  coupon Coupons @relation(fields: [couponId], references: [couponId])
}

model ProductCouponMapping {
  productCouponId Int           @id @default(autoincrement())
  productId       Int
  couponId        Int
  amount          Int
  status          ACTIVE_STATUS

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  coupon  Coupons  @relation(fields: [couponId], references: [couponId])
  product Products @relation(fields: [productId], references: [productId])
}

model Orders {
  orderId     Int    @id @default(autoincrement())
  description String
  productId   Int
  userOrderId Int
  price       String

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  userOrder UserOrder @relation(fields: [userOrderId], references: [id])
  product   Products  @relation(fields: [productId], references: [productId])
}

model UserOrder {
  id             Int            @id @default(autoincrement())
  userId         Int
  orderNumber    String
  paymentMode    PAYMENT_MODE
  paymentStatus  PAYMENT_STATUS
  gstCharge      Float
  handlingCharge Float
  shipping       Int
  discount       Int
  discountType   CURRENCY_TYPE
  total          Int
  shippingTime   DateTime       @default(now())
  arrivalTime    DateTime
  status         ORDER_STATUS

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  user   Users    @relation(fields: [userId], references: [userId])
  orders Orders[]
}

model UserCart {
  cartId    Int @id @default(autoincrement())
  productId Int
  userId    Int
  quantity  Int

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  user    Users    @relation(fields: [userId], references: [userId])
  product Products @relation(fields: [productId], references: [productId])
}

model UserSession {
  userSessionId Int    @id @default(autoincrement())
  userId        Int
  token         String

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  user Users @relation(fields: [userId], references: [userId])
}
