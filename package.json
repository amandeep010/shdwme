{
  "name": "shubham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "prisma:format": "npx prisma format",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prettier:list": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write",
    "format": "yarn prettier:fix && npm lint"
  },
  "engines": {
    "node": ">=24"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm prettier:list"
